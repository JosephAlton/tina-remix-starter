{
  "name": "tina-remix-starter",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "tinacms build && remix vite:build",
    "dev": "tinacms dev -c \"remix vite:dev\"",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "node:version": "node -v",
    "packages:update:checkpoint": "pnpm update --interactive --latest && pnpm install && git add . && git commit -m 'auto update packages' && git push",
    "packages:update": "pnpm update --interactive --latest && pnpm install"
  },
  "dependencies": {
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "isbot": "^5.1.41",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinacms": "^3.9.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@tinacms/cli": "^2.4.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}